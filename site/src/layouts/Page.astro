---
import '../styles/site.css';
import { pageSeo } from '../seo';
import { REPO_URL, TABSH_URL } from '../site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const seo = pageSeo({ title, description, pathname: Astro.url.pathname });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tabs" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(seo.imageWidth)} />
    <meta property="og:image:height" content={String(seo.imageHeight)} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={seo.jsonLd} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="brand" href="/" aria-label="Tabs, home">
        <svg viewBox="0 0 34 22" fill="none" aria-hidden="true">
          <path
            fill="currentColor"
            d="M22.624.129H11.376C5.379.129.5 5.006.5 10.999c0 5.995 4.879 10.872 10.876 10.872h11.248C28.621 21.87 33.5 16.994 33.5 11S28.621.129 22.624.129m9.189 10.046h-4.09c-.271-3.565-2.29-6.649-5.2-8.397h.1c4.81 0 8.77 3.696 9.188 8.397zM17 20.102c-.811 0-1.82-1.34-2.468-3.711h4.934c-.647 2.37-1.657 3.71-2.468 3.71zm-2.822-5.341a22 22 0 0 1-.284-2.937h6.211a22 22 0 0 1-.283 2.937zm-.284-4.586c.036-1.069.134-2.052.284-2.937h5.644c.15.885.25 1.868.284 2.937zm.64-4.567c.646-2.37 1.656-3.71 2.466-3.71s1.82 1.34 2.468 3.71zm5.398-3.226a9.15 9.15 0 0 1 4.4 3.226h-3.179c-.3-1.23-.709-2.34-1.22-3.226m-7.085 3.226H9.669a9.15 9.15 0 0 1 4.399-3.226c-.512.887-.921 1.997-1.221 3.226M8.71 7.238h3.812c-.15.953-.244 1.945-.277 2.937H7.933a9 9 0 0 1 .777-2.937m3.535 4.586c.033.991.126 1.983.277 2.937H8.71a9 9 0 0 1-.777-2.937zm.603 4.567c.3 1.23.709 2.34 1.22 3.226A9.15 9.15 0 0 1 9.67 16.39zm8.307 0h3.178a9.15 9.15 0 0 1-4.398 3.226c.512-.887.92-1.997 1.22-3.226m4.139-1.63H21.48c.15-.953.244-1.946.277-2.937h4.312a9 9 0 0 1-.776 2.937m-3.536-4.586a24 24 0 0 0-.277-2.937h3.813c.414.91.683 1.898.776 2.937zM11.376 1.78h.1c-2.91 1.747-4.929 4.831-5.2 8.397H2.186c.419-4.7 4.38-8.397 9.189-8.397M2.187 11.825h4.09c.271 3.565 2.29 6.649 5.2 8.397h-.1c-4.81 0-8.77-3.697-9.189-8.397m20.437 8.397h-.1c2.91-1.747 4.929-4.831 5.2-8.397h4.09c-.419 4.7-4.38 8.397-9.189 8.397"
          ></path>
        </svg>
        Tabs
      </a>
      <nav aria-label="Primary">
        <a href={TABSH_URL}>tabsh.cc</a>
        <a href={REPO_URL}>GitHub</a>
        <a class="pill-link" href="#get">Download</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="footer-top">
          <span>Tabs — a browser for the Mac with tabsh inside it.</span>
          <nav class="footer-links" aria-label="Footer">
            <a href={TABSH_URL}>tabsh.cc</a>
            <a href="/#faq">Questions</a>
            <a href={REPO_URL}>GitHub</a>
            <a href={`${REPO_URL}/releases`}>Releases</a>
            <a href={`${REPO_URL}/blob/main/FORK.md`}>Fork notes</a>
          </nav>
        </div>
        <p class="colophon">
          Tabs is made by Blaise. Built on <a href="https://github.com/driceroland/Search">Search</a>
          {' '}by Office Commun, under the MIT license.
        </p>
      </div>
    </footer>
  </body>
</html>
